# Copier ce fichier : cp .env.example .env
# Puis remplir avec vos propres clés API

# OpenWeather API — plan gratuit suffisant
# https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ScrapingBee — nécessaire pour Booking.com (anti-bot)
# https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# Amazon S3 — stockage cloud des données
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=eu-west-3
S3_BUCKET_NAME=your-bucket-name
S3_RAW_PREFIX=kayak/raw/
S3_PROCESSED_PREFIX=kayak/processed/
S3_FINAL_PREFIX=kayak/final/

# Neon PostgreSQL — base de données cloud serverless
# https://neon.tech/
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
